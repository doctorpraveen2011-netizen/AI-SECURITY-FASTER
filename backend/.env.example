# ==========================================
# AI SECURITY FASTER — Environment Configuration
# ==========================================

# Core Application Settings
PROJECT_NAME="AI SECURITY FASTER"
VERSION="2.0.0"
ENVIRONMENT="development"
SECRET_KEY="ai-security-faster-super-secret-enterprise-jwt-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQLite local or PostgreSQL enterprise)
DATABASE_URL="sqlite:///./ai_security_faster.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_security_faster"

# AI Model Provider Credentials
# Enter your real frontier model API keys below for live testing
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Email Gateway Settings (Resend or SendGrid)
EMAIL_API_KEY=""
EMAIL_PROVIDER="resend"
EMAIL_FROM="AI Security Faster <onboarding@resend.dev>"

# Default Models
CLAUDE_DEFAULT_MODEL="claude-3-5-sonnet-20241022"
GEMINI_DEFAULT_MODEL="gemini-1.5-pro"

# SIEM Integration (Wazuh 4.x)
WAZUH_API_URL="https://localhost:55000"
WAZUH_USER="wazuh"
WAZUH_PASSWORD="wazuh_password"
WAZUH_SIMULATED_MODE="true"

# Agent Sandbox Directory
SANDBOX_DIR="./data/sandbox"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

